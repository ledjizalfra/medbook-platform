# =======================================================================================
# File in cui definimo regole per escludere file e cartelle dal controllo di versione Git.
# =======================================================================================

# Compiled Java files
*.class

# Maven build output
target/
**/target/

# IDE settings (non escludiamo il source code IDE)
.idea/
.vscode/
.claude/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment & Secrets (IMPORTANTE: non committare credenziali)
.env
.env.local
*.key
*.pem
*.jks
*.keystore

# Logs
*.log

# Node modules (se usato nel frontend)
node_modules/

# Documentazione: includi docs/, escludi solo il rapporto finale e file temporanei Office
docs/raporto-finale/
~$*
