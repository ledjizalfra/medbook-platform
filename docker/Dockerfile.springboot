# API Gateway
FROM eclipse-temurin:21-jre AS api-gateway
WORKDIR /app
COPY --from=build /workspace/edge/api-gateway/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","app.jar"]
