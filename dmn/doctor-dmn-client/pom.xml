<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.pegaso.projectwork.medbook</groupId>
        <artifactId>medbook-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>doctor-dmn-client</artifactId>
    <packaging>jar</packaging>
    <name>MedBook - Doctor DMN Client</name>
    <description>
        Libreria client per la comunicazione con doctor-dmn via OpenFeign.
        Contiene l'interfaccia FeignClient e i DTO condivisi generati dalla spec OpenAPI.
        Da importare nei DMN che hanno bisogno di chiamare doctor-dmn.
    </description>

    <dependencies>

        <!-- OpenFeign — interfaccia client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Spring Web — per le annotazioni REST sui client generati -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation — per i DTO generati -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jackson — serializzazione JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Jackson Databind nullable: per gestire i campi nullable negli oggetti api generati -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Genera FeignClient e DTO dalla spec OpenAPI di doctor-dmn -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-doctor-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <!-- Salta la generazione finché lo YAML non è pronto -->
                            <skip>true</skip>
                            <!-- Usa la stessa spec del doctor-dmn -->
                            <inputSpec>
                                ${project.basedir}/../doctor-dmn/src/main/resources/openapi/doctor-api_v1.0.yaml
                            </inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>
                                it.pegaso.projectwork.medbook.doctor.client.api
                            </apiPackage>
                            <modelPackage>
                                it.pegaso.projectwork.medbook.doctor.client.model
                            </modelPackage>
                            <configOptions>
                                <!-- Genera solo l'interfaccia -->
                                <interfaceOnly>true</interfaceOnly>
                                <!-- Genera FeignClient invece di RestController -->
                                <library>spring-cloud</library>
                                <useJakartaEe>true</useJakartaEe>
                                <useTags>true</useTags>
                                <useBeanValidation>true</useBeanValidation>
                                <useSpringBoot3>true</useSpringBoot3>
                                <documentationProvider>springdoc</documentationProvider>
                                <!-- Genera LocalDateTime invece di OffsetDateTime -->
                                <dateLibrary>java8-localdatetime</dateLibrary>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Aggiunge le sources generate al classpath di compilazione -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/openapi/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>