{
  "clientName": "MedBook Platform - Doctor API",
  "dateExported": "2026-03-29",
  "version": "1.0.0",
  "description": "Collezione completa di request per testare l'API Doctor DMN",
  "requests": [
    {
      "name": "1. Create Doctor",
      "method": "POST",
      "url": "{{base_url_doctor}}/api/v1/doctors",
      "description": "Registra un nuovo medico sulla piattaforma",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "firstName": "Luca",
        "lastName": "Bianchi",
        "dateOfBirth": "1975-06-20",
        "gender": "MASCHILE",
        "email": "luca.bianchi@medbook.it",
        "phone": "+393331234567",
        "licenseNumber": "RM-12345"
      },
      "expectedStatus": 201
    },
    {
      "name": "2. Create Doctor - Alternative Example",
      "method": "POST",
      "url": "{{base_url_doctor}}/api/v1/doctors",
      "description": "Registra un nuovo medico - Alternative data",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "firstName": "Marco",
        "lastName": "Rossi",
        "dateOfBirth": "1980-05-15",
        "gender": "MASCHILE",
        "email": "marco.rossi@medbook.it",
        "phone": "+393334567890",
        "licenseNumber": "RM-54321"
      },
      "expectedStatus": 201
    },
    {
      "name": "3. Create Doctor - Female Example",
      "method": "POST",
      "url": "{{base_url_doctor}}/api/v1/doctors",
      "description": "Registra un nuovo medico - Gender FEMALE",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "firstName": "Giulia",
        "lastName": "Verdi",
        "dateOfBirth": "1985-08-22",
        "gender": "FEMMINILE",
        "email": "giulia.verdi@medbook.it",
        "phone": "+393335678901",
        "licenseNumber": "MI-99999"
      },
      "expectedStatus": 201
    },
    {
      "name": "4. Get All Doctors - No Filters",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=0&size=20&sort=lastName,asc",
      "description": "Lista paginata di tutti i medici",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "5. Get All Doctors - Filter by Status",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=0&size=20&status=ACTIVE",
      "description": "Lista medici filtrati per stato ACTIVE",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "6. Get All Doctors - Filter by LastName",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=0&size=20&lastName=Bianchi",
      "description": "Lista medici filtrati per cognome (ricerca parziale)",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "7. Get All Doctors - Filter by Specialization",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=0&size=20&specialization=CARDIOLOGY",
      "description": "Lista medici filtrati per specializzazione",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "8. Get All Doctors - Multiple Filters",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=0&size=10&status=ACTIVE&lastName=Rossi&specialization=INTERNAL_MEDICINE",
      "description": "Lista medici con multipli filtri applicati",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "9. Get All Doctors - Pagination",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors?page=1&size=5&sort=firstName,desc",
      "description": "Lista medici con paginazione e ordinamento inverso",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "10. Get Doctor By ID",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Recupera i dettagli completi di un medico",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "11. Get Doctor By ID - Invalid ID",
      "method": "GET",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-999",
      "description": "Tenta di recuperare un medico inesistente",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 404
    },
    {
      "name": "12. Update Doctor - Full Update",
      "method": "PATCH",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Aggiorna parzialmente i dati del medico (tutti i campi)",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "firstName": "Luca",
        "lastName": "Bianchi",
        "dateOfBirth": "1975-06-20",
        "email": "luca.bianchi.updated@medbook.it",
        "phone": "+393339999999",
        "status": "ATTIVO"
      },
      "expectedStatus": 200
    },
    {
      "name": "13. Update Doctor - Email Only",
      "method": "PATCH",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Aggiorna solo l'email del medico",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "email": "luca.bianchi.newemail@medbook.it"
      },
      "expectedStatus": 200
    },
    {
      "name": "14. Update Doctor - Status Change",
      "method": "PATCH",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Cambia lo stato del medico a SUSPENDED",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "status": "SOSPESO"
      },
      "expectedStatus": 200
    },
    {
      "name": "15. Update Doctor - Phone Update",
      "method": "PATCH",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Aggiorna il numero di telefono del medico",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+393331111111"
      },
      "expectedStatus": 200
    },
    {
      "name": "16. Delete Doctor",
      "method": "DELETE",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-1",
      "description": "Esegue il soft delete di un medico",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 200
    },
    {
      "name": "17. Delete Doctor - Invalid ID",
      "method": "DELETE",
      "url": "{{base_url_doctor}}/api/v1/doctors/DOC-999",
      "description": "Tenta di eliminare un medico inesistente",
      "headers": {
        "Authorization": "Bearer {{access_token}}",
        "Content-Type": "application/json"
      },
      "expectedStatus": 404
    }
  ],
  "environments": [
    {
      "name": "Development",
      "variables": {
        "base_url_doctor": "http://localhost:8091",
        "access_token": "your_jwt_token_here"
      }
    },
    {
      "name": "Production",
      "variables": {
        "base_url_doctor": "https://api.medbook.it",
        "access_token": "your_jwt_token_here"
      }
    }
  ],
  "notes": {
    "business_keys": "Tutti gli ID medico seguono il formato DOC-{seq} (es. DOC-1, DOC-42)",
    "soft_delete": "Il DELETE non elimina fisicamente il record dal DB, ma lo marca come cancellato",
    "patch_vs_put": "Si usa PATCH per aggiornamenti parziali - gli endpoint non supportano PUT",
    "authentication": "Tutti gli endpoint richiedono un JWT valido nell'header Authorization",
    "immutable_fields": "Non sono modificabili: doctorId, licenseNumber, gender",
    "unique_constraints": "Email e licenseNumber devono essere univoci nel sistema",
    "pagination": "Default: page=0, size=20. Max size=100",
    "trace_id": "Presente in tutte le risposte per correlazione dei log end-to-end",
    "genders": ["MASCHILE", "FEMMINILE"],
    "statuses": ["ATTIVO", "DISATTIVO", "SOSPESO"],
    "specializations": [
      "CARDIOLOGIA",
      "DERMATOLOGY",
      "ENDOCRINOLOGY",
      "GASTROENTEROLOGY",
      "GENERAL_MEDICINE",
      "GYNECOLOGY",
      "INTERNAL_MEDICINE",
      "NEUROLOGY",
      "ONCOLOGY",
      "OPHTHALMOLOGY",
      "ORTHOPEDICS",
      "OTOLARYNGOLOGY",
      "PEDIATRICS",
      "PSYCHIATRY",
      "PULMONOLOGY",
      "RADIOLOGY",
      "RHEUMATOLOGY",
      "UROLOGY"
    ]
  }
}

