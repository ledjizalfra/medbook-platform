<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.pegaso.projectwork.medbook</groupId>
        <artifactId>medbook-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>medbook-commons</artifactId>
    <packaging>jar</packaging>
    <name>MedBook - Commons</name>
    <description>
        Shared library for all MedBook DMNs.
        Contains BaseEntity, common exceptions, DTOs, security config
        and others configurations.
    </description>

    <dependencies>
        <!--
            All dependencies are marked as optional = true because
            medbook-commons is a shared library used by DMNs, Edge and Infrastructure modules.
            Not all modules need all dependencies (e.g. eureka-server and api-gateway have no database).
            Each module explicitly declares only the dependencies it needs in its own pom.xml.
        -->

        <!-- Spring Data JPA — for BaseEntity and @MappedSuperclass -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web — for error response DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jakarta Validation — per ConstraintViolationException nel GlobalExceptionHandler -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Feign — per gestire FeignException nel GlobalExceptionHandler -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security — per MedBookSecurityConfig -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OAuth2 Resource Server — per JWT validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AOP — per il logging automatico delle operazioni -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct — mapper interface -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security Core — for SecurityContextHolder in AuditorAware -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
        </dependency>

        <!-- Spring Boot Test — per test unitari nel modulo commons -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Cache — infrastruttura cache condivisa (@EnableCaching, @Cacheable) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Caffeine — provider cache in-memory ad alte prestazioni -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson JSR310 — serializzazione delle date Java 8 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Swagger Annotations — per @Schema sui modelli generati da OpenAPI -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Encoder JSON per Logback — usato in produzione per ELK/Kibana -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Genera MedBookErrorResponse dalla spec OpenAPI condivisa -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-commons-models</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>
                                ${project.basedir}/src/main/resources/openapi/medbook-commons-api.yaml
                            </inputSpec>
                            <generatorName>spring</generatorName>
                            <!-- Genera solo i modelli — nessuna API/controller -->
                            <generateApis>false</generateApis>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <!-- Package unico per tutti i modelli condivisi -->
                            <modelPackage>
                                it.pegaso.projectwork.medbook.commons.api.model
                            </modelPackage>
                            <configOptions>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java8-localdatetime</dateLibrary>
                                <openApiNullable>false</openApiNullable>
                                <!-- useInheritanceWithComposedSchemas=true → genera Java "extends" da allOf+$ref
                                     senza questa opzione il generator appiattisce allOf duplicando i campi -->
                                <useInheritanceWithComposedSchemas>true</useInheritanceWithComposedSchemas>
                                <!-- false → non genera @JsonTypeInfo/@JsonSubTypes sul parent,
                                     evita che "responseType" appaia nel JSON delle response -->
                                <legacyDiscriminatorBehavior>false</legacyDiscriminatorBehavior>
                                <!-- @SuperBuilder → builder con chain su tutta la gerarchia:
                                       MedBookApiErrorResponse.builder().httpStatus(404).errorCode("X").build()
                                     @NoArgsConstructor → costruttore no-arg per il controller:
                                       new MedBookApiResponse() -->
                                <additionalModelTypeAnnotations>@lombok.experimental.SuperBuilder @lombok.NoArgsConstructor</additionalModelTypeAnnotations>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Aggiunge le sources generate al classpath di compilazione -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/openapi/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>